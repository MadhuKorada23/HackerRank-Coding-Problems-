class Solution {
    public int longestOnes(int[] nums, int k) {
        int zc=0;
        int s=0;
        int mo=0;
        for(int end=0;end<nums.length;end++){
            if(nums[end]==0)
                zc++;
                while(zc>k){
                    if(nums[s]==0)
                    zc--;
                    s++;
                }
            mo=Math.max(mo,end-s+1);
        }
        return mo;
        
    }
}