class Solution {
    public int[] twoSum(int[] arr, int t) {
        int i=0 ;
        int j=arr.length-1;
        while(i<j){
            if(arr[i]+arr[j]>t){
                j--;
            }
            else if(arr[i]+arr[j]<t){
                i++;
            }
            else{
                return new int[]{i+1,j+1};
            }
        }
        return null;
    }
}