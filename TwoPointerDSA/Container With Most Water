class Solution {
    public int maxArea(int[] height) {
        int left=0;
        int right=height.length-1;
        int MaxArea=0;
        while(left<right){
            int Area=Math.min(height[right],height[left])*(right-left);
            MaxArea=Math.max(Area,MaxArea);
            if(height[left]<height[right]){
                left++;
            }
            else{
                right--;
            }
        }
        return MaxArea;
        
    }
}