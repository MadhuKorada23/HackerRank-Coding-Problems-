class Solution {
public:

    bool sim(char x){
            if(x=='a'||x=='e'||x=='i'||x=='o'||x=='u'){
                return true;
            }
            else return false;
        }

    int maxVowels(string s, int k) {

        int i=0;
        int j=0;
        int ans=0;
        // unorderd_map<char,int> freq;
        int count=0;
        while(j<s.length()){
            if(j-i+1<k){
                if(sim(s[j]))
                    count++;
                j++;
            }else{
                if(sim(s[j]))
                    count++;
                ans = max(ans,count);
                count -= sim(s[i])?1:0;
                i++;
                j++;
            }
        }

        return ans;
    }
};